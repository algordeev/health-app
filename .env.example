# Copy to .env (never commit). Server values go into Supabase with:
#   supabase secrets set --env-file .env

# Supabase (app uses URL + publishable key; Edge Functions get the service role automatically)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Google OAuth: "health-connect" web client (server-side code exchange)
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_CLOUD_PROJECT_NUMBER=

# Google Sign-In (native) client IDs used by the Flutter app
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Webhooks: shared secret Google sends in the Authorization header
HEALTH_WEBHOOK_SECRET=

# Signs the OAuth `state` param (random 32+ bytes)
OAUTH_STATE_SECRET=

# Claude (Edge Functions only)
ANTHROPIC_API_KEY=
